{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"__REPO__/claude/hooks/plumb_guard.py\""
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit|mcp__atlassian__createJiraIssue|mcp__atlassian__createIssueLink|mcp__atlassian__addCommentToJiraIssue",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"__REPO__/claude/hooks/mason_guard.py\""
          }
        ]
      }
    ]
  }
}
